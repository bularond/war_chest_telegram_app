# Какая половина программы это. `both` — одна машина делает всё, так было
# всегда и так остаётся по умолчанию. `app` — только приложение: клиент, сокет,
# база; в Telegram не ходит вовсе. `chat` — только бот в чате: ни порта, ни
# базы, ни движка, нужен лишь выход на api.telegram.org.
#
# Делить есть смысл, когда до приложения и до Telegram дотягиваются из разных
# мест. Опрос допускает одного читателя на токен, поэтому `chat` должен быть
# ровно один, а `app` не опрашивает никогда — даже если PUBLIC_URL ему задали.
ROLE=both

# Обязателен при NODE_ENV=production — без него сервер не стартует.
# Обязателен и при ROLE=chat, каким бы ни был NODE_ENV.
# Взять у @BotFather.
TELEGRAM_BOT_TOKEN=

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Адрес, по которому мини-приложение открывается снаружи. Нужен боту: кнопку
# «Играть» в чате нельзя дать без абсолютного https-адреса. Без него бот на
# сообщения не отвечает, игра при этом работает. При ROLE=chat обязателен —
# такому процессу больше нечего сказать, и без адреса он не стартует.
PUBLIC_URL=https://warchestapp.example.com

# SQLite: профили и история партий. Лобби и партии живут в памяти.
DB_PATH=war-chest.db

# Каталог со сборкой клиента; по умолчанию packages/client/dist
# CLIENT_DIR=

LOG_LEVEL=info
