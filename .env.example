# Обязателен при NODE_ENV=production — без него сервер не стартует.
# Взять у @BotFather.
TELEGRAM_BOT_TOKEN=

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# SQLite: профили и история партий. Лобби и партии живут в памяти.
DB_PATH=war-chest.db

# Каталог со сборкой клиента; по умолчанию packages/client/dist
# CLIENT_DIR=

LOG_LEVEL=info
