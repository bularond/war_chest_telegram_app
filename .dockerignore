**/dist
**/dist-types
**/*.tsbuildinfo
.env
.env.local
*.db
*.db-shm
*.db-wal
*.db-journal
design
rulebooks
war_chest_pnp
warchest.units.clean
weights
docs
.DS_Store
**/.DS_Store
Dockerfile
docker-compose.yml
docker-compose.chat.yml

