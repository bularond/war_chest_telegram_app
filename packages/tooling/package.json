    "sprt": "node dist/sprt-cli.js",
    "tune": "node dist/tune-cli.js",
    "lab": "node dist/lab-cli.js",
    "spsa": "node dist/spsa-cli.js",
    "ladder": "node dist/ladder-cli.js",
    "unit-value": "node dist/unit-value-cli.js",
    "regress": "node dist/regress-cli.js"
